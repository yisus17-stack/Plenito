---
const apkUrl = "https://github.com/yisus17-stack/Plenito/releases/download/v1.0.0/pleno.apk";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="Pleno — Tu día, tu plan, tu mejor versión. Descarga la app para Android."
    />

    <title>Pleno — Tu día, tu plan, tu mejor versión</title>

    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />

    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>

    <!-- ===================================================== -->
    <!-- DECORACIONES DEL FONDO -->
    <!-- ===================================================== -->

    <div
      class="bg-decorations"
      aria-hidden="true"
    >

      <!-- Mancha inferior izquierda -->
      <svg
        class="bg-blob-bottom-left"
        viewBox="0 0 600 600"
        fill="none"
      >
        <path
          d="M0 300C120 280 200 420 300 480C400 540 520 480 600 600H0V300Z"
          fill="rgba(255,255,255,0.06)"
        />
      </svg>

      <!-- Mancha inferior derecha -->
      <svg
        class="bg-blob-bottom-right"
        viewBox="0 0 700 700"
        fill="none"
      >
        <path
          d="M700 350C580 320 500 450 400 500C300 550 180 500 100 700H700V350Z"
          fill="rgba(255,255,255,0.05)"
        />
      </svg>

      <!-- Líneas punteadas -->
      <svg
        class="bg-dashed-trail"
        viewBox="0 0 1200 800"
        fill="none"
        preserveAspectRatio="none"
      >

        <path
          d="M-50 450 C 150 200, 450 150, 700 240 C 950 330, 1100 200, 1250 80"
          stroke="rgba(255,255,255,0.28)"
          stroke-width="2.5"
          stroke-dasharray="8 8"
        />

        <path
          d="M400 850 C 550 650, 800 600, 1100 750"
          stroke="rgba(255,255,255,0.25)"
          stroke-width="2.5"
          stroke-dasharray="8 8"
        />

        <path
          d="M850 120 C 950 40, 1120 60, 1180 180"
          stroke="rgba(255,255,255,0.22)"
          stroke-width="2.5"
          stroke-dasharray="6 6"
        />

      </svg>

      <!-- Avioncito -->
      <svg
        class="bg-plane"
        viewBox="0 0 64 64"
        fill="none"
      >
        <path
          d="M8 32 L56 12 L38 56 L30 38 L8 32 Z"
          stroke="rgba(255,255,255,0.55)"
          stroke-width="2.8"
          stroke-linejoin="round"
          stroke-linecap="round"
        />

        <path
          d="M30 38 L56 12"
          stroke="rgba(255,255,255,0.55)"
          stroke-width="2.5"
          stroke-linecap="round"
        />
      </svg>

      <!-- Calendario -->
      <svg
        class="bg-calendar"
        viewBox="0 0 100 90"
        fill="none"
      >

        <rect
          x="10"
          y="18"
          width="80"
          height="62"
          rx="14"
          stroke="rgba(255,255,255,0.38)"
          stroke-width="3"
        />

        <line
          x1="10"
          y1="36"
          x2="90"
          y2="36"
          stroke="rgba(255,255,255,0.38)"
          stroke-width="2.5"
        />

        <line
          x1="28"
          y1="10"
          x2="28"
          y2="22"
          stroke="rgba(255,255,255,0.45)"
          stroke-width="3.5"
          stroke-linecap="round"
        />

        <line
          x1="72"
          y1="10"
          x2="72"
          y2="22"
          stroke="rgba(255,255,255,0.45)"
          stroke-width="3.5"
          stroke-linecap="round"
        />

        <circle
          cx="30"
          cy="50"
          r="3"
          fill="rgba(255,255,255,0.4)"
        />

        <circle
          cx="50"
          cy="50"
          r="3"
          fill="rgba(255,255,255,0.4)"
        />

        <circle
          cx="70"
          cy="50"
          r="3"
          fill="rgba(255,255,255,0.4)"
        />

        <circle
          cx="30"
          cy="65"
          r="3"
          fill="rgba(255,255,255,0.4)"
        />

        <circle
          cx="50"
          cy="65"
          r="3"
          fill="rgba(255,255,255,0.4)"
        />

        <circle
          cx="70"
          cy="65"
          r="3"
          fill="rgba(255,255,255,0.4)"
        />

      </svg>

    </div>


    <!-- ===================================================== -->
    <!-- HERO -->
    <!-- ===================================================== -->

    <main class="page-wrapper">

      <div class="hero-layout">

        <!-- ================================================= -->
        <!-- COLUMNA IZQUIERDA -->
        <!-- ================================================= -->

        <section class="hero-left">

          <!-- Logo -->
          <div class="logo-wrapper">

            <img
              src="/images/logo_pleno_blanco.svg"
              alt="Pleno"
              class="logo-img"
            />

          </div>


          <!-- Texto -->
          <h1 class="slogan">

            <span class="slogan-line-1">
              Tu día, tu plan,
            </span>

            <span class="slogan-line-2">
              tu mejor versión.
            </span>


          </h1>


          <!-- Botón -->
          <div class="cta-group">

            <a
              href={apkUrl}
              download
              class="btn-download"
            >

              <svg
                class="download-icon"
                viewBox="0 0 24 24"
                width="28"
                height="28"
                fill="none"
                stroke="currentColor"
                stroke-width="2.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M12 3v12" />
                <path d="m6.5 10 5.5 5.5 5.5-5.5" />
                <path d="M4 20h16" />
              </svg>

              <span>
                Descargar para Android
              </span>

            </a>


            <p class="tagline-sub">
              Organiza
              <span>•</span>
              Planifica
              <span>•</span>
              Avanza
            </p>

          </div>

        </section>


        <!-- ================================================= -->
        <!-- PERSONAJE -->
        <!-- ================================================= -->

        <section class="hero-right">

          <div class="mascot-container">

            <img
              src="/images/login_image.png"
              alt="Mascota Pleno"
              class="mascot-img"
            />

          </div>

        </section>

      </div>

    </main>

  </body>
</html>


<style>

  /* ======================================================= */
  /* RESET */
  /* ======================================================= */

  :global(*) {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }


  :global(html) {
    width: 100%;
    height: 100%;
  }


  :global(body) {
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;

    overflow-x: hidden;

    font-family:
      "Plus Jakarta Sans",
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    background: #35A0F8;

    color: #FFFFFF;
  }


  /* ======================================================= */
  /* FONDO */
  /* ======================================================= */

  .bg-decorations {
    position: fixed;
    inset: 0;

    width: 100%;
    height: 100%;

    pointer-events: none;

    overflow: hidden;

    z-index: 0;
  }


  .bg-blob-bottom-left {
    position: absolute;

    bottom: -120px;
    left: -100px;

    width: min(520px, 42vw);

    height: auto;
  }


  .bg-blob-bottom-right {
    position: absolute;

    bottom: -130px;
    right: -100px;

    width: min(620px, 50vw);

    height: auto;
  }


  .bg-dashed-trail {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;
  }


  .bg-plane {
    position: absolute;

    top: 13%;
    left: 55%;

    width: clamp(42px, 4vw, 65px);

    height: auto;

    transform: rotate(5deg);
  }


  .bg-calendar {
    position: absolute;

    top: 35%;
    right: 2%;

    width: clamp(85px, 8vw, 130px);

    height: auto;

    transform: rotate(6deg);

    opacity: 0.85;
  }


  /* ======================================================= */
  /* CONTENEDOR PRINCIPAL */
  /* ======================================================= */

  .page-wrapper {
    position: relative;

    z-index: 2;

    width: 100%;

    min-height: 100vh;
    min-height: 100dvh;

    display: flex;

    justify-content: center;
    align-items: center;

    padding:
      clamp(30px, 4vh, 60px)
      clamp(40px, 7vw, 120px);
  }


  .hero-layout {
    width: 100%;

    max-width: 1450px;

    display: grid;

    grid-template-columns:
      minmax(0, 0.95fr)
      minmax(0, 1.05fr);

    align-items: center;

    gap: clamp(40px, 5vw, 90px);
  }


  /* ======================================================= */
  /* IZQUIERDA */
  /* ======================================================= */

  .hero-left {
    width: 100%;

    display: flex;

    flex-direction: column;

    align-items: flex-start;

    justify-content: center;

    text-align: left;

    padding-left: clamp(15px, 3.5vw, 65px);
  }


  /* ======================================================= */
  /* LOGO */
  /* ======================================================= */

  .logo-wrapper {
    margin-bottom:
      clamp(26px, 4vh, 46px);
  }


  .logo-img {
    display: block;

    width: clamp(300px, 31vw, 520px);

    max-width: 100%;

    height: auto;

    filter:
      drop-shadow(
        0 4px 10px
        rgba(0, 0, 0, 0.10)
      );
  }


  /* ======================================================= */
  /* SLOGAN */
  /* ======================================================= */

  .slogan {
    width: 100%;

    display: flex;

    flex-direction: column;

    align-items: flex-start;

    font-size:
      clamp(2.6rem, 4vw, 4.5rem);

    font-weight: 800;

    line-height: 1.06;

    letter-spacing: -1.5px;

    margin-bottom:
      clamp(32px, 4vh, 46px);
  }


  .slogan-line-1 {
    display: block;

    color: #FFFFFF;
  }


  .slogan-line-2 {
    display: block;

    color: #FFD84D;

    margin-top: 7px;
  }


  /* ======================================================= */
  /* LÍNEA AMARILLA */
  /* ======================================================= */

  .yellow-underline {
    display: block;

    width: min(72%, 420px);

    height: auto;

    margin-top: 9px;

    margin-left: 8px;

    object-fit: contain;

    pointer-events: none;
  }


  /* ======================================================= */
  /* CTA */
  /* ======================================================= */

  .cta-group {
    display: flex;

    flex-direction: column;

    align-items: flex-start;

    gap: 17px;
  }


  .btn-download {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 14px;

    padding:
      19px
      clamp(34px, 3vw, 52px);

    background: #FFD84D;

    color: #15191F;

    font-size:
      clamp(1.05rem, 1.35vw, 1.3rem);

    font-weight: 800;

    line-height: 1;

    text-decoration: none;

    border-radius: 999px;

    box-shadow:
      0 8px 0 rgba(16, 36, 62, 0.16),
      0 18px 35px rgba(0, 0, 0, 0.12);

    transition:
      transform 150ms ease,
      box-shadow 150ms ease,
      background-color 150ms ease;

    cursor: pointer;

    user-select: none;
  }


  .btn-download:hover {
    background: #FFE264;

    transform:
      translateY(-3px);

    box-shadow:
      0 10px 0 rgba(16, 36, 62, 0.16),
      0 22px 38px rgba(0, 0, 0, 0.15);
  }


  .btn-download:active {
    transform:
      translateY(3px);

    box-shadow:
      0 4px 0 rgba(16, 36, 62, 0.16),
      0 10px 18px rgba(0, 0, 0, 0.12);
  }


  .download-icon {
    flex-shrink: 0;
  }


  .tagline-sub {
    padding-left: 30px;

    display: flex;

    align-items: center;

    gap: 11px;

    font-size:
      clamp(0.92rem, 1.05vw, 1.08rem);

    font-weight: 600;

    color:
      rgba(255, 255, 255, 0.82);

    letter-spacing: 0.2px;
  }


  .tagline-sub span {
    color:
      rgba(255, 255, 255, 0.68);
  }


  /* ======================================================= */
  /* PERSONAJE */
  /* ======================================================= */

  .hero-right {
    width: 100%;

    min-width: 0;

    display: flex;

    justify-content: center;

    align-items: flex-end;

    align-self: stretch;
  }


  .mascot-container {
    width: 100%;

    min-height: 520px;

    display: flex;

    align-items: flex-end;

    justify-content: center;
  }


  .mascot-img {
    display: block;

    width: min(100%, 650px);

    height: auto;

    max-height: 76vh;

    object-fit: contain;

    object-position:
      center bottom;

    filter:
      drop-shadow(
        0 18px 35px
        rgba(0, 0, 0, 0.13)
      );
  }


  /* ======================================================= */
  /* LAPTOPS PEQUEÑAS */
  /* ======================================================= */

  @media (max-width: 1150px) {

    .page-wrapper {
      padding-left: 40px;
      padding-right: 40px;
    }


    .hero-layout {
      gap: 35px;
    }


    .logo-img {
      width:
        clamp(270px, 32vw, 410px);
    }


    .slogan {
      font-size:
        clamp(2.3rem, 4vw, 3.6rem);
    }


    .mascot-img {
      max-height: 68vh;
    }

  }


  /* ======================================================= */
  /* TABLET / MÓVIL */
  /* ======================================================= */

  @media (max-width: 900px) {

    :global(html),
    :global(body) {
      width: 100%;

      height: auto;

      min-height: 100%;

      overflow-x: hidden;

      overflow-y: auto;
    }


    .bg-decorations {
      position: absolute;

      min-height: 100%;
    }


    .page-wrapper {
      min-height: 100svh;

      height: auto;

      padding:
        40px
        20px
        0;
    }


    .hero-layout {
      display: flex;

      flex-direction: column;

      align-items: center;

      justify-content: flex-start;

      gap: 0;
    }


    /* ========================================= */
    /* PARTE SUPERIOR */
    /* ========================================= */

    .hero-left {
      width: 100%;

      align-items: center;

      text-align: center;
    }


    .logo-wrapper {
      width: 100%;

      display: flex;

      justify-content: center;

      margin-bottom: 26px;
    }


    .logo-img {
      width: min(78vw, 340px);

      height: auto;
    }


    /* ========================================= */
    /* TEXTO */
    /* ========================================= */

    .slogan {
      width: 100%;

      align-items: center;

      text-align: center;

      font-size:
        clamp(2rem, 9vw, 3.1rem);

      line-height: 1.07;

      letter-spacing: -0.8px;

      margin-bottom: 34px;
    }


    .slogan-line-1,
    

    .slogan-line-2 {
      margin-top: 6px;
    }


    /* ========================================= */
    /* LÍNEA */
    /* ========================================= */

    .yellow-underline {
      width:
        min(68%, 290px);

      margin-top: 9px;

      margin-left: 0;
    }


    /* ========================================= */
    /* BOTÓN */
    /* ========================================= */

    .cta-group {
      width: 100%;

      align-items: center;

      gap: 15px;
    }


    .btn-download {
      width:
        min(100%, 390px);

      padding:
        17px
        22px;

      font-size:
        clamp(1rem, 4.4vw, 1.17rem);
    }


    .download-icon {
      width: 24px;
      height: 24px;
    }


    .tagline-sub {
      padding-left: 0;

      justify-content: center;

      flex-wrap: wrap;

      gap: 8px;

      font-size:
        clamp(0.78rem, 3.4vw, 0.98rem);
    }


    /* ========================================= */
    /* PERSONAJE HASTA ABAJO */
    /* ========================================= */

    .hero-right {
      width: 100%;

      min-height: 0;

      margin-top: 34px;

      display: flex;

      align-items: flex-end;

      justify-content: center;
    }


    .mascot-container {
      width: 100%;

      min-height: 0;

      height: auto;

      display: flex;

      align-items: flex-end;

      justify-content: center;
    }


    .mascot-img {
      width:
        min(100%, 500px);

      height: auto;

      max-height: none;

      margin: 0 auto;

      object-position:
        center bottom;
    }


    /* ========================================= */
    /* DECORACIONES */
    /* ========================================= */

    .bg-plane {
      top: 3%;

      left: 4%;

      width: 40px;
    }


    .bg-calendar {
      top: 36%;

      right: -8px;

      width: 78px;
    }


    .bg-dashed-trail {
      opacity: 0.70;
    }

  }


  /* ======================================================= */
  /* CELULARES PEQUEÑOS */
  /* ======================================================= */

  @media (max-width: 480px) {

    .page-wrapper {
      padding:
        28px
        16px
        0;
    }


    .logo-wrapper {
      margin-bottom: 20px;
    }


    .logo-img {
      width: min(76vw, 290px);
    }


    .slogan {
      font-size:
        clamp(1.85rem, 9.5vw, 2.6rem);

      margin-bottom: 30px;
    }


    .yellow-underline {
      width:
        min(64%, 240px);

      margin-top: 8px;
    }


    .btn-download {
      width: 100%;

      max-width: 360px;

      padding:
        16px
        18px;

      gap: 11px;
    }


    .tagline-sub {
      font-size: 0.78rem;
    }


    .hero-right {
      margin-top: 26px;
    }


    .mascot-img {
      width: min(105%, 430px);
    }


    .bg-calendar {
      top: 34%;

      right: -20px;

      opacity: 0.6;
    }

  }


  /* ======================================================= */
  /* PANTALLAS MUY BAJAS EN PC */
  /* ======================================================= */

  @media (min-width: 901px) and (max-height: 720px) {

    .page-wrapper {
      padding-top: 20px;
      padding-bottom: 20px;
    }


    .logo-wrapper {
      margin-bottom: 18px;
    }


    .logo-img {
      width:
        clamp(270px, 28vw, 400px);
    }


    .slogan {
      font-size:
        clamp(2.2rem, 3.6vw, 3.5rem);

      margin-bottom: 26px;
    }


    .yellow-underline {
      width: min(66%, 340px);

      margin-top: 6px;
    }


    .mascot-container {
      min-height: 440px;
    }


    .mascot-img {
      max-height: 65vh;
    }


    .btn-download {
      padding:
        16px
        36px;
    }

  }

</style>